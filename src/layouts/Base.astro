---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../site';
import { localePath, type Lang } from '../i18n';

interface Props { lang: Lang; path: string; title?: string; description?: string }
const { lang, path, title, description = '' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Creative Project Manager`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="en" href={localePath('en', path)} />
    <link rel="alternate" hreflang="es" href={localePath('es', path)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Instrument+Serif:ital@1&family=Sora:wght@300;400;500;600&family=Merriweather:ital,opsz,wght@0,18..144,300;0,18..144,400;0,18..144,700;1,18..144,300&family=Outfit:wght@500;600&display=swap" rel="stylesheet" />
    <link href={url('fonts/clarity-city/clarity-city.css')} rel="stylesheet" />
    <script is:inline>
      // Cada página nueva se abre arriba del todo (el botón Atrás conserva la posición).
      addEventListener('pageshow', () => {
        const nav = performance.getEntriesByType('navigation')[0];
        if (!location.hash && (!nav || nav.type !== 'back_forward')) scrollTo({ top: 0, behavior: 'instant' });
      });
    </script>
  </head>
  <body>
    <canvas class="bg-lines bg-glow" aria-hidden="true"></canvas>
    <canvas class="bg-lines bg-core" aria-hidden="true"></canvas>
    <Header lang={lang} path={path} />
    <main><slot /></main>
    <Footer lang={lang} />
    <script>
      // Aparición suave de los elementos al hacer scroll.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Fondo: haces de luz que corren hacia un punto de fuga a la derecha, con los colores de la imagen de referencia.
      // Dos lienzos: uno difuminado por CSS para el resplandor y otro nítido para los núcleos.
      const glowCanvas = document.querySelector<HTMLCanvasElement>('.bg-glow');
      const canvas = document.querySelector<HTMLCanvasElement>('.bg-core');
      const gctx = glowCanvas?.getContext('2d');
      const ctx = canvas?.getContext('2d');
      if (canvas && ctx && glowCanvas && gctx) {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // De arriba abajo, como en la imagen: rojo y rosa arriba, magenta y violeta en medio, azul abajo, con algún naranja.
        const BANDS = [
          ['255, 59, 92', '255, 92, 110', '255, 106, 77'],
          ['230, 70, 160', '224, 91, 255', '255, 92, 110'],
          ['160, 92, 255', '138, 92, 255', '224, 91, 255'],
          ['80, 80, 255', '61, 77, 255', '122, 160, 255'],
          ['61, 77, 255', '122, 160, 255', '255, 138, 61'],
        ];
        const colorFor = (y0: number) => {
          const band = BANDS[Math.max(0, Math.min(BANDS.length - 1, Math.floor(((y0 + h * 0.35) / (h * 1.7)) * BANDS.length)))];
          return band[Math.floor(Math.random() * band.length)];
        };
        type Lane = { y0: number; core: number };
        type Streak = { lane: Lane; t: number; len: number; speed: number; color: string; width: number; bright: number };
        let w = 0, h = 0, vx = 0, vy = 0, lanes: Lane[] = [], streaks: Streak[] = [], last = 0;
        // Punto en un carril: t = 0 en el borde izquierdo, t = 1 en el punto de fuga.
        const pos = (l: Lane, t: number): [number, number] => [-60 + (vx + 60) * t, l.y0 + (vy - l.y0) * t];
        const resize = () => {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          w = innerWidth; h = innerHeight; vx = w * 1.35; vy = h * 0.42;
          canvas.width = w * dpr; canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          glowCanvas.width = w / 2; glowCanvas.height = h / 2;
          gctx.setTransform(0.5, 0, 0, 0.5, 0, 0);
          lanes = Array.from({ length: 60 }, () => ({ y0: -h * 0.35 + Math.random() * h * 1.7, core: Math.random() }));
          streaks = [];
          for (let i = 0; i < 40; i++) { spawn(); streaks[i].t = Math.random(); }
        };
        const spawn = () => {
          const lane = lanes[Math.floor(Math.random() * lanes.length)];
          streaks.push({
            lane, t: -0.4 - Math.random() * 0.3,
            len: 0.25 + Math.random() * 0.45,
            speed: 0.1 + Math.random() * 0.22,
            color: colorFor(lane.y0),
            width: 4 + Math.random() * 20,
            bright: 0.35 + Math.random() * 0.65,
          });
        };
        const beam = (c: CanvasRenderingContext2D, s: Streak, widthMul: number, alpha: number) => {
          const tail = Math.max(0, s.t - s.len), head = Math.min(1, s.t);
          if (head <= tail) return;
          const [x0, y0] = pos(s.lane, tail), [x1, y1] = pos(s.lane, head);
          const g = c.createLinearGradient(x0, y0, x1, y1);
          g.addColorStop(0, `rgba(${s.color}, 0)`);
          g.addColorStop(0.75, `rgba(${s.color}, ${alpha})`);
          g.addColorStop(1, `rgba(${s.color}, ${alpha * 1.15})`);
          c.strokeStyle = g;
          // Más gruesos a la izquierda (cerca) y finos al acercarse al punto de fuga.
          c.lineWidth = Math.max(0.5, s.width * widthMul * (1 - head * 0.85));
          c.beginPath(); c.moveTo(x0, y0); c.lineTo(x1, y1); c.stroke();
        };
        const draw = (now: number) => {
          const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
          ctx.clearRect(0, 0, w, h); gctx.clearRect(0, 0, w, h);
          ctx.globalCompositeOperation = gctx.globalCompositeOperation = 'lighter';
          ctx.lineCap = gctx.lineCap = 'butt';
          // Carriles de fondo, casi invisibles.
          for (const l of lanes) {
            const [x0, y0] = pos(l, 0), [x1, y1] = pos(l, 1);
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.01 + l.core * 0.02})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
          }
          for (const s of streaks) {
            s.t += s.speed * dt;
            beam(gctx, s, 2.4, 0.06 * s.bright); // halo difuso
            beam(gctx, s, 0.8, 0.12 * s.bright); // cuerpo
            beam(ctx, s, 0.1, 0.2 * s.bright);   // núcleo
          }
          streaks = streaks.filter((s) => s.t - s.len < 1);
          while (streaks.length < 40) spawn();
          ctx.globalCompositeOperation = 'source-over';
          if (!still) requestAnimationFrame(draw);
        };
        resize();
        addEventListener('resize', resize);
        requestAnimationFrame(draw);
      }
    </script>
  </body>
</html>
